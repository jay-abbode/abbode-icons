# Copy this file to ".env.local" (note the dot at the start) and fill in the values below.
# For local development, the service-account credentials are read from
# google-credentials.json in the project root, so you don't need to put them here.

# --- Google Sheets ---
GOOGLE_SHEET_ID=1zP1wTjPpYxhEQ4GnF8pCLdZj1DiyoGIrwEr3VWrLbqo
GOOGLE_SHEET_TAB=MASTER
# Tab the "Live Order Data" dropdown reads (written by scripts/icon_order_stats).
# Optional — defaults to ORDER_STATS if unset.
GOOGLE_ORDER_STATS_TAB=ORDER_STATS
# Tab the "Composite Data" page reads (also written by scripts/icon_order_stats).
# Optional — defaults to COMPOSITE if unset.
GOOGLE_COMPOSITE_TAB=COMPOSITE
# Tabs the "Trends" page reads (also written by scripts/icon_order_stats).
# Optional — default to ICON_TRENDS / COLOR_TRENDS if unset.
GOOGLE_ICON_TRENDS_TAB=ICON_TRENDS
GOOGLE_COLOR_TRENDS_TAB=COLOR_TRENDS

# --- Sign-in (NextAuth) ---
# Generate a random secret with:   openssl rand -base64 32
# Or, on Windows, paste any long random string (40+ chars).
AUTH_SECRET=replace-me-with-a-long-random-string

# OAuth client ID + secret from Google Cloud Console
# (Credentials → Create Credentials → OAuth Client ID → Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Email domain that's auto-approved to sign in. Anyone with an @ALLOWED_DOMAIN
# email gets in without being added to the ACCESS sheet.
ALLOWED_DOMAIN=shopabbode.com
